    u_xlat26.xyz = u_xlat1.xxx * u_xlat27.xyz + u_xlat26.xyz;
    u_xlat1.xyz = (-u_xlat26.xyz) + _WakeFoamMaskDebugColor.xyz;
    u_xlat26.xyz = u_xlat14.xxx * u_xlat1.xyz + u_xlat26.xyz;
    u_xlat1.xyz = (-u_xlat26.xyz) + _RippleColor.xyz;
    u_xlat0.xyz = u_xlat0.xxx * u_xlat1.xyz + u_xlat26.xyz;
    u_xlat0.w = 1.0;
    u_xlat0 = u_xlat0 * vs_INTERP2;
    SV_TARGET0 = max(u_xlat0, vec4(0.0, 0.0, 0.0, 0.0));
    return;
}

