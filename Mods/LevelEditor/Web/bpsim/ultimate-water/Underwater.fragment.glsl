    u_xlat9.xy = u_xlat1.xy * vec2(-2.0, -2.0) + vec2(3.0, 3.0);
    u_xlat1.xy = u_xlat1.xy * u_xlat1.xy;
    u_xlat1.xy = u_xlat1.xy * u_xlat9.xy;
    u_xlat1.x = min(u_xlat1.x, u_xlat2.x);
    u_xlat1.x = (u_xlatb15.x) ? u_xlat1.x : 1.0;
    u_xlat8.x = u_xlat1.y * u_xlat1.x;
    u_xlat1.x = (u_xlatb15.y) ? u_xlat8.x : u_xlat1.x;
    u_xlat1.x = min(u_xlat1.x, 1.0);
    u_xlat8.x = _UnderwaterEdgeFadeEnabled;
    u_xlat8.x = clamp(u_xlat8.x, 0.0, 1.0);
    u_xlat1.x = u_xlat1.x + -1.0;
    u_xlat0.w = u_xlat8.x * u_xlat1.x + 1.0;
    u_xlat0 = u_xlat0 * vs_INTERP2;
    u_xlatb1 = u_xlat0.w==0.0;
    if(u_xlatb1){discard;}
    u_xlat1.xy = vs_INTERP3.xy / vs_INTERP3.ww;
    u_xlat1.xyz = texture(_ShapeLightTexture0, (uw_world-uw_LightRect.xy)/uw_LightRect.zw, _GlobalMipBias.x).xyz;
    u_xlat22 = dot(_ShapeLightMaskFilter0, _ShapeLightMaskFilter0);
    u_xlatb22 = u_xlat22!=0.0;
    u_xlat2 = (-_ShapeLightInvertedFilter0) + vec4(1.0, 1.0, 1.0, 1.0);
    u_xlat2.x = dot(u_xlat2, _ShapeLightMaskFilter0);
    u_xlat2.xyz = u_xlat1.xyz * u_xlat2.xxx;
    u_xlat1.xyz = (bool(u_xlatb22)) ? u_xlat2.xyz : u_xlat1.xyz;
    u_xlat2.xyz = u_xlat1.xyz * _ShapeLightBlendFactors0.xxyx.yyy;
    u_xlat1.xyz = u_xlat1.xyz * vec3(_ShapeLightBlendFactors0.y, _ShapeLightBlendFactors0.y, _ShapeLightBlendFactors0.y);
    u_xlat1.xyz = u_xlat0.xyz * u_xlat2.xyz + u_xlat1.xyz;
    u_xlat0.xyz = u_xlat1.xyz * vec3(_HDREmulationScale);
    SV_TARGET0 = max(u_xlat0, vec4(0.0, 0.0, 0.0, 0.0));
    SV_TARGET0.rgb=uwEncodeScene(SV_TARGET0.rgb);
    return;

}
