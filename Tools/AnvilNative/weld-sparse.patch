+static inline b3Matrix3 b3WeldAnchorMass( b3Matrix3 inertia, b3Vec3 anchor )
+{
+	b3Vec3 columnX = b3Sub( b3MulSV( anchor.z, inertia.cy ), b3MulSV( anchor.y, inertia.cz ) );
+	b3Vec3 columnY = b3Sub( b3MulSV( anchor.x, inertia.cz ), b3MulSV( anchor.z, inertia.cx ) );
+	b3Vec3 columnZ = b3Sub( b3MulSV( anchor.y, inertia.cx ), b3MulSV( anchor.x, inertia.cy ) );
+	return (b3Matrix3){
+		b3Cross( anchor, columnX ), b3Cross( anchor, columnY ), b3Cross( anchor, columnZ ),
+	};
+}
